#!/usr/bin/env python3

import os, json, struct, hmac, hashlib, time
from dataclasses import dataclass
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec, x25519
from cryptography.hazmat.primitives.kdf.hkdf import HKDFExpand
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.exceptions import InvalidSignature, InvalidTag

# ------------------------------------------------------------------ util
class HandshakeError(Exception):
    """Handshake / pesan ditolak (fail-closed)."""

def encode(*parts) -> bytes:
    """Encoding tak-ambigu: tiap bagian diberi prefix panjang 4 byte."""
    out = b""
    for p in parts:
        if isinstance(p, str): p = p.encode()
        elif isinstance(p, int): p = struct.pack(">Q", p)
        out += struct.pack(">I", len(p)) + p
    return out

def sha256(*parts) -> bytes:
    return hashlib.sha256(encode(*parts)).digest()

def pub_bytes_ec(pub) -> bytes:
    return pub.public_bytes(serialization.Encoding.X962,
                            serialization.PublicFormat.UncompressedPoint)

def load_ec_pub(raw: bytes):
    return ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), raw)

def ecdsa_sign(priv, data: bytes) -> bytes:
    return priv.sign(data, ec.ECDSA(hashes.SHA256()))

def ecdsa_verify(pub, data: bytes, sig: bytes) -> bool:
    try:
        pub.verify(sig, data, ec.ECDSA(hashes.SHA256())); return True
    except InvalidSignature:
        return False

def x25519_raw(pub) -> bytes:
    return pub.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)

# ------------------------------------------------------------------ PKI
@dataclass
class Cert:
    serial: int
    subject: str
    public_key: bytes      # IK_pub (P-256, uncompressed)
    not_before: int
    not_after: int
    key_usage: str
    ca_signature: bytes = b""

    def tbs(self) -> bytes:   # "to be signed"
        return encode(self.serial, self.subject, self.public_key,
                      self.not_before, self.not_after, self.key_usage)
    def to_bytes(self) -> bytes:
        return encode(self.tbs(), self.ca_signature)

class CA:
    def __init__(self, name="TrustedCA"):
        self.name = name
        self._priv = ec.generate_private_key(ec.SECP256R1())
        self.pub = self._priv.public_key()
        self._serial = 0
        self.revoked = set()

    def issue(self, subject, ik_pub, days=365, now=None, key_usage="digitalSignature"):
        now = int(now if now is not None else time.time())
        self._serial += 1
        c = Cert(self._serial, subject, pub_bytes_ec(ik_pub), now,
                 now + days * 86400, key_usage)
        c.ca_signature = ecdsa_sign(self._priv, c.tbs())
        return c

    def revoke(self, cert): self.revoked.add(cert.serial)

    def publish_crl(self, now=None):
        """CRL bertanda tangan CA, berisi daftar serial + waktu terbit."""
        now = int(now if now is not None else time.time())
        body = encode(now, *sorted(self.revoked))
        return {"issued_at": now, "revoked": set(self.revoked),
                "sig": ecdsa_sign(self._priv, body), "body": body}

CRL_MAX_AGE = 7 * 86400

def validate_cert(cert, expected_id, ca_pub, crl, now):
    """Validasi lengkap; melempar HandshakeError bila ada satu saja yang gagal."""
    if not ecdsa_verify(ca_pub, cert.tbs(), cert.ca_signature):
        raise HandshakeError("tanda tangan CA pada sertifikat tidak valid")
    if cert.subject != expected_id:
        raise HandshakeError(f"subject '{cert.subject}' != yang diharapkan '{expected_id}'")
    if not (cert.not_before <= now <= cert.not_after):
        raise HandshakeError("sertifikat di luar masa berlaku")
    if cert.key_usage != "digitalSignature":
        raise HandshakeError("key usage tidak sesuai")
    if crl is None or not ecdsa_verify(ca_pub, crl["body"], crl["sig"]):
        raise HandshakeError("CRL tidak tersedia / tanda tangan CRL tidak valid (fail-closed)")
    if now - crl["issued_at"] > CRL_MAX_AGE:
        raise HandshakeError("CRL kedaluwarsa (fail-closed)")
    if cert.serial in crl["revoked"]:
        raise HandshakeError("sertifikat sudah dicabut (CRL)")
    return load_ec_pub(cert.public_key)

# ------------------------------------------------------------------ key derivation
def derive_keys(ek_priv, peer_ek_pub_raw, transcript_1):
    try:
        secret = ek_priv.exchange(x25519.X25519PublicKey.from_public_bytes(peer_ek_pub_raw))
    except ValueError:                           # library menolak output nol
        raise HandshakeError("shared secret nol (titik berordo kecil)")
    if secret == bytes(32):                      # titik berordo kecil
        raise HandshakeError("shared secret nol (titik berordo kecil)")
    # HKDF-Extract manual (RFC 5869): PRK = HMAC(salt, IKM)
    prk = hmac.new(transcript_1, secret, hashlib.sha256).digest()
    def expand(info): return HKDFExpand(hashes.SHA256(), 32, info).derive(prk)
    return {"A2B": expand(b"chat-v1 key A->B"), "B2A": expand(b"chat-v1 key B->A"),
            "conf_A": expand(b"chat-v1 confirm A"), "conf_B": expand(b"chat-v1 confirm B")}

def mac(key, label, transcript):
    return hmac.new(key, encode(label, transcript), hashlib.sha256).digest()

# ------------------------------------------------------------------ party
class Party:
    """Satu kelas untuk Alice (initiator) dan Bob (responder)."""
    def __init__(self, name, peer_name, ca_pub, ca_ref, role, now=None, ik=None, cert=None):
        self.name, self.peer, self.role = name, peer_name, role   # role: 'A' / 'B'
        self.ca_pub = ca_pub
        self.now = lambda: int(now if now is not None else time.time())
        self.ik_priv = ik or ec.generate_private_key(ec.SECP256R1())
        self.cert = cert
        self.crl = ca_ref.publish_crl(self.now())
        self.ek_priv = None
        self.keys = self.session_id = None
        self.seq_send = 0; self.last_recv = 0

    # --- langkah handshake ---
    def msg1(self):                                               # Alice
        self.ek_priv = x25519.X25519PrivateKey.generate()
        self.nonce = os.urandom(32)
        self.hello_A = encode("chat-v1", self.name, self.peer, self.cert.to_bytes(),
                              x25519_raw(self.ek_priv.public_key()), self.nonce)
        return {"hello_A": self.hello_A, "cert": self.cert, "ek": x25519_raw(self.ek_priv.public_key()),
                "nonce": self.nonce, "from": self.name, "to": self.peer}

    def msg2(self, m1):                                           # Bob
        if m1["to"] != self.name or m1["from"] != self.peer:
            raise HandshakeError("identitas pengirim/penerima pada Hello_A tidak sesuai")
        self.peer_ik = validate_cert(m1["cert"], self.peer, self.ca_pub, self.crl, self.now())
        hello_A = encode("chat-v1", m1["from"], m1["to"], m1["cert"].to_bytes(), m1["ek"], m1["nonce"])
        self.ek_priv = x25519.X25519PrivateKey.generate()
        ek_pub = x25519_raw(self.ek_priv.public_key()); nonce_B = os.urandom(32)
        hello_B = encode("chat-v1", self.name, self.peer, self.cert.to_bytes(), ek_pub, nonce_B)
        self.T1 = sha256(hello_A, hello_B)
        sig_B = self.sig_B = ecdsa_sign(self.ik_priv, encode("responder-sig", self.T1))
        self.keys = derive_keys(self.ek_priv, m1["ek"], self.T1)
        self.ek_priv = None                                       # hapus SEGERA -> forward secrecy
        return {"hello_B": hello_B, "cert": self.cert, "ek": ek_pub, "nonce": nonce_B,
                "sig_B": sig_B, "from": self.name, "to": self.peer}

    def msg3(self, m2):                                           # Alice
        if m2["to"] != self.name or m2["from"] != self.peer:
            raise HandshakeError("identitas pada Hello_B tidak sesuai")
        peer_ik = validate_cert(m2["cert"], self.peer, self.ca_pub, self.crl, self.now())
        hello_B = encode("chat-v1", m2["from"], m2["to"], m2["cert"].to_bytes(), m2["ek"], m2["nonce"])
        self.T1 = sha256(self.hello_A, hello_B)                   # dari data MILIK Alice
        if not ecdsa_verify(peer_ik, encode("responder-sig", self.T1), m2["sig_B"]):
            raise HandshakeError("sig_B tidak cocok dengan transkrip Alice (indikasi MITM)")
        self.keys = derive_keys(self.ek_priv, m2["ek"], self.T1)
        self.ek_priv = None
        self.T2 = sha256(self.T1, m2["sig_B"])
        self.sig_A = ecdsa_sign(self.ik_priv, encode("initiator-sig", self.T2))
        self.mac_A = mac(self.keys["conf_A"], "A", self.T2)
        return {"sig_A": self.sig_A, "mac_A": self.mac_A}

    def msg4(self, m3):                                           # Bob
        self.T2 = sha256(self.T1, self.sig_B)       # sig_B yang Bob kirim sendiri
        if not ecdsa_verify(self.peer_ik, encode("initiator-sig", self.T2), m3["sig_A"]):
            raise HandshakeError("sig_A tidak valid")
        if not hmac.compare_digest(m3["mac_A"], mac(self.keys["conf_A"], "A", self.T2)):
            raise HandshakeError("MAC_A salah (key confirmation gagal)")
        self.T3 = sha256(self.T2, m3["sig_A"], m3["mac_A"])
        self.session_id = hashlib.sha256(self.T3).digest()[:16]
        return {"mac_B": mac(self.keys["conf_B"], "B", self.T3)}

    def finish(self, m4):                                         # Alice
        self.T3 = sha256(self.T2, self.sig_A, self.mac_A)
        if not hmac.compare_digest(m4["mac_B"], mac(self.keys["conf_B"], "B", self.T3)):
            raise HandshakeError("MAC_B salah (key confirmation gagal)")
        self.session_id = hashlib.sha256(self.T3).digest()[:16]

    # --- pesan ---
    def _dirs(self):
        return ("A2B", "B2A") if self.role == "A" else ("B2A", "A2B")

    def send(self, plaintext: bytes):
        d_send, _ = self._dirs()
        self.seq_send += 1
        nonce = bytes(4) + struct.pack(">Q", self.seq_send)       # unik per kunci arah
        aad = encode(self.session_id, d_send, self.seq_send)
        ct = AESGCM(self.keys[d_send]).encrypt(nonce, plaintext, aad)  # ct || tag
        return {"session_id": self.session_id, "dir": d_send, "seq": self.seq_send, "ct": ct}

    def recv(self, pkt):
        _, d_recv = self._dirs()
        if pkt["session_id"] != self.session_id: raise HandshakeError("session_id salah")
        if pkt["dir"] != d_recv:                 raise HandshakeError("arah salah (reflection?)")
        if pkt["seq"] <= self.last_recv:         raise HandshakeError(f"replay/urutan lama (seq={pkt['seq']})")
        nonce = bytes(4) + struct.pack(">Q", pkt["seq"])          # diturunkan receiver
        aad = encode(self.session_id, d_recv, pkt["seq"])
        try:
            pt = AESGCM(self.keys[d_recv]).decrypt(nonce, pkt["ct"], aad)
        except InvalidTag:
            raise HandshakeError("tag AES-GCM tidak valid (dimodifikasi)")
        self.last_recv = pkt["seq"]                               # update SETELAH sukses
        return pt

# ------------------------------------------------------------------ jaringan + Eve
def run_handshake(alice, bob, adversary=None):
    """adversary(nama_pesan, msg) -> msg yang diteruskan (Eve bisa mengubah)."""
    adv = adversary or (lambda n, m: m)
    m1 = adv("hello_A", alice.msg1())
    m2 = adv("hello_B", bob.msg2(m1))
    m3 = adv("auth_A", alice.msg3(m2))
    m4 = adv("auth_B", bob.msg4(m3))
    alice.finish(m4)

NOW = 1_800_000_000
def setup(now=NOW, ca=None):
    ca = ca or CA()
    ik_a = ec.generate_private_key(ec.SECP256R1()); ik_b = ec.generate_private_key(ec.SECP256R1())
    cert_a = ca.issue("Alice", ik_a.public_key(), now=now); cert_b = ca.issue("Bob", ik_b.public_key(), now=now)
    A = Party("Alice", "Bob", ca.pub, ca, "A", now, ik_a, cert_a)
    B = Party("Bob", "Alice", ca.pub, ca, "B", now, ik_b, cert_b)
    return ca, A, B

# ------------------------------------------------------------------ skenario
results = []
def scenario(title, expect_ok, fn):
    try:
        info = fn()
        ok = True; detail = info or ""
    except HandshakeError as e:
        ok = False; detail = str(e)
    passed = (ok == expect_ok)
    results.append(passed)
    status = "LULUS" if passed else "GAGAL"
    hasil = "diterima" if ok else "DITOLAK"
    print(f"[{status}] {title}\n        -> {hasil}: {detail}")

def s_normal():
    _, A, B = setup(); run_handshake(A, B)
    assert A.session_id == B.session_id and A.keys == B.keys
    p1 = B.recv(A.send(b"Halo Bob, ini rahasia"))
    p2 = A.recv(B.send(b"Halo Alice, diterima"))
    return f"Bob membaca {p1!r}; Alice membaca {p2!r}"

def s_eavesdrop():
    _, A, B = setup(); run_handshake(A, B)
    pkt = A.send(b"rahasia-super")
    assert b"rahasia-super" not in pkt["ct"]
    return f"Eve hanya melihat ciphertext {pkt['ct'].hex()[:32]}..."

def s_tamper_ct():
    _, A, B = setup(); run_handshake(A, B)
    pkt = A.send(b"transfer 10"); ct = bytearray(pkt["ct"]); ct[0] ^= 1; pkt["ct"] = bytes(ct)
    B.recv(pkt)

def s_tamper_aad():
    _, A, B = setup(); run_handshake(A, B)
    pkt = A.send(b"halo"); pkt["seq"] += 5                    
    B.recv(pkt)

def s_replay():
    _, A, B = setup(); run_handshake(A, B)
    pkt = A.send(b"bayar 100"); B.recv(pkt); B.recv(pkt)

def s_reflect():
    _, A, B = setup(); run_handshake(A, B)
    pkt = A.send(b"halo"); A.recv(pkt)     # Eve memantulkan pesan Alice kembali ke Alice

def s_swap_ekA():
    _, A, B = setup()
    eve_ek = x25519.X25519PrivateKey.generate()
    def adv(n, m):
        if n == "hello_A": m = dict(m); m["ek"] = x25519_raw(eve_ek.public_key())
        return m
    run_handshake(A, B, adv)

def s_swap_ekB():
    _, A, B = setup()
    eve_ek = x25519.X25519PrivateKey.generate()
    def adv(n, m):
        if n == "hello_B": m = dict(m); m["ek"] = x25519_raw(eve_ek.public_key())
        return m
    run_handshake(A, B, adv)

def s_fake_ca_cert():
    ca, A, B = setup()
    fake = CA("EveCA"); eve_ik = ec.generate_private_key(ec.SECP256R1())
    fake_cert = fake.issue("Bob", eve_ik.public_key(), now=NOW)   # subject 'Bob' tapi CA palsu
    def adv(n, m):
        if n == "hello_B": m = dict(m); m["cert"] = fake_cert
        return m
    run_handshake(A, B, adv)

def s_eve_legit_cert():
    ca, A, B = setup()
    eve_ik = ec.generate_private_key(ec.SECP256R1())
    eve_cert = ca.issue("Eve", eve_ik.public_key(), now=NOW)      # sah, tapi atas nama Eve
    def adv(n, m):
        if n == "hello_B": m = dict(m); m["cert"] = eve_cert
        return m
    run_handshake(A, B, adv)

def s_expired():
    ca, A, B = setup(now=NOW)
    A.now = lambda: NOW + 400 * 86400; B.now = A.now
    A.crl = ca.publish_crl(A.now()); B.crl = ca.publish_crl(B.now())
    run_handshake(A, B)

def s_revoked():
    ca, A, B = setup(); ca.revoke(B.cert)
    A.crl = ca.publish_crl(NOW); B.crl = A.crl
    run_handshake(A, B)

def s_no_crl():
    ca, A, B = setup(); A.crl = None
    run_handshake(A, B)

def s_replay_old_hello_B():
    ca, A1, B1 = setup(); recorded = {}
    def rec(n, m):
        recorded[n] = m; return m
    run_handshake(A1, B1, rec)                                    # sesi lama direkam Eve
    _, A2, B2 = setup(ca=ca)
    A2.ca_pub = ca.pub
    A2.cert = A1.cert; A2.ik_priv = A1.ik_priv
    def adv(n, m):
        return recorded["hello_B"] if n == "hello_B" else m       # replay Hello_B lama
    run_handshake(A2, B2, adv)

def s_low_order():
    _, A, B = setup()
    def adv(n, m):
        if n == "hello_A": m = dict(m); m["ek"] = bytes(32)       # titik berordo kecil
        return m
    run_handshake(A, B, adv)

def s_forward_secrecy():
    _, A, B = setup(); run_handshake(A, B)
    assert A.ek_priv is None and B.ek_priv is None
    return ("EK_priv sudah dihapus di kedua pihak; kebocoran IK_A_priv/IK_B_priv di masa depan "
            "tidak cukup untuk menghitung kunci sesi lama")

def s_ca_swapped():
    """DI LUAR model ancaman: Alice memakai app palsu dengan CA_pub milik Eve."""
    ca, A, B = setup()
    eve_ca = CA("EveCA"); eve_ik = ec.generate_private_key(ec.SECP256R1())
    A.ca_pub = eve_ca.pub; A.crl = eve_ca.publish_crl(NOW)
    eve_cert = eve_ca.issue("Bob", eve_ik.public_key(), now=NOW)
    # Eve = Bob palsu penuh (ia menjalankan Party 'Bob' dengan kunci & sertifikat dari CA-nya)
    fake_bob = Party("Bob", "Alice", eve_ca.pub, eve_ca, "B", NOW, eve_ik, eve_cert)
    # Eve juga perlu memvalidasi Cert_A: dia menerima sertifikat Alice yang asli dari CA asli
    fake_bob.ca_pub = ca.pub; fake_bob.crl = ca.publish_crl(NOW)
    run_handshake(A, fake_bob)
    return "Alice mengira berbicara dengan Bob, padahal Eve (jaminan gugur - sesuai batas di Bab 7)"

if __name__ == "__main__":
    print("=" * 70, "\nSIMULASI SECURE CHAT - PKI + X25519 + ECDSA + AES-GCM\n" + "=" * 70)
    scenario("1. Pesan normal Alice<->Bob",                      True,  s_normal)
    scenario("2. Eve menyadap ciphertext",                       True,  s_eavesdrop)
    scenario("3. Eve memodifikasi ciphertext",                   False, s_tamper_ct)
    scenario("4. Eve memodifikasi AAD (seq_no)",                 False, s_tamper_aad)
    scenario("5. Eve me-replay pesan lama",                      False, s_replay)
    scenario("6. Eve memantulkan pesan (reflection)",            False, s_reflect)
    scenario("7. Eve mengganti EK_A_pub",                        False, s_swap_ekA)
    scenario("8. Eve mengganti EK_B_pub",                        False, s_swap_ekB)
    scenario("9. Cert_B diganti sertifikat dari CA palsu",       False, s_fake_ca_cert)
    scenario("10. Cert_B diganti sertifikat sah atas nama Eve",  False, s_eve_legit_cert)
    scenario("11. Sertifikat kedaluwarsa",                       False, s_expired)
    scenario("12. Sertifikat sudah dicabut (CRL)",               False, s_revoked)
    scenario("13. CRL tidak tersedia (fail-closed)",             False, s_no_crl)
    scenario("14. Eve me-replay Hello_B dari sesi lama",         False, s_replay_old_hello_B)
    scenario("15. Titik X25519 berordo kecil (nol)",             False, s_low_order)
    scenario("16. Forward secrecy: EK_priv terhapus",            True,  s_forward_secrecy)
    scenario("17. [DI LUAR MODEL] CA_pub di aplikasi diganti",   True,  s_ca_swapped)
    print("=" * 70)
    print(f"Hasil: {sum(results)}/{len(results)} skenario sesuai ekspektasi")
