import hashlib
import random
import statistics

SEED = 2026
JUMLAH_UJI = 1000

# Fungsi bantu
def bit_beda(a: bytes, b: bytes) -> int:
    """Jumlah bit yang berbeda antara dua digest."""
    return sum(bin(x ^ y).count("1") for x, y in zip(a, b))


def balik_satu_bit(data: bytes, posisi_bit: int) -> bytes:
    """Salinan data dengan tepat satu bit dibalik."""
    hasil = bytearray(data)
    hasil[posisi_bit // 8] ^= 1 << (posisi_bit % 8)
    return bytes(hasil)


def hash_lemah(data: bytes) -> bytes:
    """Hash buatan yang TIDAK aman: jumlah semua byte, output 4 byte."""
    return (sum(data) % 2**32).to_bytes(4, "big")


def sha256_potong(data: bytes, bit: int) -> int:
    """SHA-256 yang hanya diambil `bit` bit pertamanya (sebagai integer)."""
    nilai = int.from_bytes(hashlib.sha256(data).digest(), "big")
    return nilai >> (256 - bit)


def garis(judul: str) -> None:
    print()
    print("=" * 66)
    print(judul)
    print("=" * 66)


# E1. Avalanche effect
print("\n\nE1. AVALANCHE EFFECT")

rng = random.Random(SEED)
fungsi = {
    "SHA-256": lambda d: hashlib.sha256(d).digest(),
    "hash_lemah": hash_lemah,
}
hasil = {nama: [] for nama in fungsi}

for _ in range(JUMLAH_UJI):
    pesan = rng.randbytes(32)
    pesan_ubah = balik_satu_bit(pesan, rng.randrange(256))
    for nama, f in fungsi.items():
        d1, d2 = f(pesan), f(pesan_ubah)
        hasil[nama].append(bit_beda(d1, d2) / (len(d1) * 8) * 100)

print(f"\nJumlah percobaan: {JUMLAH_UJI} (pesan acak 32 byte, seed={SEED})")
print(f"\n  {'Fungsi':<11} {'Rata-rata':>10} {'Std dev':>9} {'Min':>7} {'Maks':>7}")
for nama, nilai in hasil.items():
    print(f"  {nama:<11} {statistics.mean(nilai):>9.1f}% "
          f"{statistics.stdev(nilai):>8.1f}% {min(nilai):>6.1f}% {max(nilai):>6.1f}%")

print("\nIdealnya rata-rata mendekati 50%.")


# E2. Collision pada hash_lemah
print("\n\nE2. COLLISION PADA hash_lemah")

pesan_a = b"Transfer Rp1.000.000 ke Budi"
pesan_b = b"Transfer Rp1.000.000 ke iBud"   # huruf diacak, jumlah byte sama
pesan_c = b"Transfer Rp9.000.000 ke Budi"   # angka 1 -> 9, tapi dikompensasi di bawah
# pesan_c dibuat collision: turunkan 8 pada byte lain agar jumlah tetap sama
pesan_c = bytearray(pesan_c)
pesan_c[-1] -= 8   # 'i' (105) -> 'a' (97)
pesan_c = bytes(pesan_c)

for p in (pesan_a, pesan_b, pesan_c):
    print(f"  {p.decode():<34} hash_lemah = {hash_lemah(p).hex()}"
          f"   SHA-256 = {hashlib.sha256(p).hexdigest()}")

print(f"\n  hash_lemah(A) == hash_lemah(B)? {hash_lemah(pesan_a) == hash_lemah(pesan_b)}")
print(f"  hash_lemah(A) == hash_lemah(C)? {hash_lemah(pesan_a) == hash_lemah(pesan_c)}")
print(f"  SHA-256(A)    == SHA-256(B)?    "
      f"{hashlib.sha256(pesan_a).digest() == hashlib.sha256(pesan_b).digest()}")
print("\nDampak: pesan C (nominal diubah jadi 9 juta) lolos verifikasi hash_lemah milik A.")


# E3. Collision pada SHA-256 yang dipotong (birthday attack)
print("\n\nE3. COLLISION PADA SHA-256 YANG DIPOTONG (birthday attack)")

print("\nPesan dicoba satu per satu (\"pesan-0\", \"pesan-1\", ...) sampai ada dua")
print("pesan berbeda dengan hash terpotong yang sama.\n")
print(f"  {'Panjang hash':>12} {'Percobaan':>12} {'Teori ~2^(n/2)':>16}  Collision")

for bit in (16, 24, 32, 40):
    terlihat = {}
    i = 0
    while True:
        pesan = f"pesan-{i}".encode()
        h = sha256_potong(pesan, bit)
        if h in terlihat:
            pasangan = (terlihat[h].decode(), pesan.decode())
            break
        terlihat[h] = pesan
        i += 1
    teori = 2 ** (bit // 2)
    print(f"  {bit:>9} bit {i + 1:>12,} {teori:>16,}  {pasangan[0]} & {pasangan[1]}")

print("\nUntuk SHA-256 penuh (256 bit), butuh sekitar 2^128 percobaan: tidak praktis.")


# Kesimpulan singkat
print("\n\nRINGKASAN")
print("  E1: SHA-256 memenuhi avalanche (~50%), hash_lemah gagal.")
print("  E2: hash_lemah mudah di-collision, bahkan bisa dipakai memalsukan pesan.")
print("  E3: collision resistance bergantung pada panjang output; hash pendek")
print("      cepat dipecahkan walau fungsi dasarnya SHA-256.")
